rules_version = '2';

/* =========================================================
   INLOTRANS — Reglas de Firestore (BORRADOR)

   Aplica esto en Firebase Console → Firestore Database →
   Reglas, DESPUÉS de tener al menos un usuario con
   rol "administrador" creado, o quedarás bloqueado.

   Lógica:
     - Un usuario solo puede leer su propio perfil en /usuarios.
     - Nadie puede escribir su propio perfil (rol/operación
       los asigna el administrador desde un panel que
       construiremos en la Fase 5, no el propio usuario).
     - Los administradores pueden leer/escribir todo.
     - El resto de colecciones (registros de vehículos, etc.)
       se ajustan cuando lleguemos a la Fase 2.
   ========================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdministrador() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "administrador";
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || esAdministrador());
      allow write: if request.auth != null && esAdministrador();
    }

    // Colecciones operacionales (vehículos, eventos, etc.)
    // se definen en la Fase 2 cuando construyamos
    // shared/services/vehiculos.js — por ahora, bloqueadas
    // por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
