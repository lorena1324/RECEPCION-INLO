# Copiar como servidor/.env (no se sube a git) y ajustar.

# 3000 lo usa otro proyecto en esta máquina (PROYECTO MQ)
PUERTO=3100

# Postgres local mientras desarrollamos. En AWS será el endpoint de RDS.
DATABASE_URL=postgres://inlotrans:cambiar@localhost:5432/inlotrans


# =============================================================
# IZTECH (API de cajas y metros cúbicos por vehículo)
#
# El TOKEN es una contraseña: su valor va SOLO en servidor/.env (que git
# ignora), NUNCA en este archivo, en el código ni en el navegador. Solo el
# servidor habla con Iztech; las pantallas piden los datos a /api.
# Si falta la URL o el token, la integración queda apagada (no falla nada).
# =============================================================
IZTECH_URL_BASE=
IZTECH_TOKEN=
# Cuánto vive la copia en memoria. Varias pantallas piden lo mismo a la vez y
# se atienden con UNA llamada; como las mediciones no pueden ir más de 30 s
# atrasadas entre dispositivos, la copia dura segundos, no minutos.
IZTECH_COPIA_SEGUNDOS=10
# Cajas por vehículo (ver servidor/src/cajasServicio.js)
# Cada cuántos segundos se consulta Iztech. Con la copia de 10 s y la respuesta
# de Iztech, el dato llega a las pantallas en ~20 s (requisito: menos de 30 s).
IZTECH_REFRESCO_SEGUNDOS=15
# Cuántos días atrás se mira (un vehículo puede durar más de un día adentro).
IZTECH_VENTANA_DIAS=2
# Almacenes de iLogic que corresponden a nuestras operaciones.
IZTECH_ALMACENES=J3,J4,B9
# Sencillo y Mula 20 se unificaron en una sola categoría (el sencillo). Con
# "true" la Mula 20 vuelve a ser una categoría aparte (por activar).
IZTECH_MULA20_ACTIVA=false

# Proyecto de Firebase de la aplicación: con él se verifican las sesiones de
# quien pide los datos. No es secreto (es el mismo de shared/core/firebase-config.js).
FIREBASE_PROJECT_ID=sensoria-c4616